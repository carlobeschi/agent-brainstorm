{
  "_about": "The agents the brainstorm app can use. To change them, copy this file to ~/.agent-brainstorm/agents.json (or point BRAINSTORM_AGENTS at a file) and edit it. Each agent has a \"read\" command, which may only read files in its folder (research, ideas and votes), and a \"build\" command, which may also edit them (building the winning ideas). The prompt goes on stdin unless a command has {prompt}. {model} is filled from \"model\"; with an empty model, the flag before {model} is dropped and the program's default model is used. {price} is \"max_price\". \"env\" lists the environment variables the agent may see (an API key, say); it gets nothing else from your shell. \"can_run\": true if its build sandbox lets it run commands. \"clean_home\": true runs the agent with an empty home folder of its own, so it loads none of your skills or settings. \"research\" (optional) is the command for the research step: read-only, and with \"web\": true it may also search and read the web, nothing else; without it the research step uses \"read\". Commands with flags that loosen permissions are refused.",
  "agents": [
    {
      "id": "claude", "label": "Claude", "model": "", "env": ["ANTHROPIC_API_KEY", "CLAUDE_CONFIG_DIR"], "web": true,
      "read": ["claude", "-p", "--model", "{model}", "--tools", "Read,Glob,Grep", "--permission-mode", "dontAsk", "--strict-mcp-config", "--safe-mode"],
      "research": ["claude", "-p", "--model", "{model}", "--tools", "Read,Glob,Grep,WebSearch,WebFetch", "--permission-mode", "dontAsk", "--strict-mcp-config", "--safe-mode", "--settings", "{\"permissions\":{\"allow\":[\"WebSearch\",\"WebFetch\"]}}"],
      "build": ["claude", "-p", "--model", "{model}", "--tools", "Read,Edit,Write,Glob,Grep", "--permission-mode", "acceptEdits", "--strict-mcp-config", "--safe-mode"]
    },
    {
      "id": "codex", "label": "Codex", "model": "", "env": ["OPENAI_API_KEY", "CODEX_HOME"], "can_run": true, "web": true,
      "read": ["codex", "exec", "-s", "read-only", "--skip-git-repo-check", "--ignore-user-config", "--ignore-rules", "-m", "{model}", "-"],
      "research": ["codex", "exec", "-s", "read-only", "--skip-git-repo-check", "--ignore-user-config", "--ignore-rules", "-c", "web_search=\"live\"", "-m", "{model}", "-"],
      "build": ["codex", "exec", "-s", "workspace-write", "--skip-git-repo-check", "--ignore-user-config", "--ignore-rules", "-c", "sandbox_workspace_write.network_access=false", "-m", "{model}", "-"]
    },
    {
      "id": "gemini", "label": "Gemini", "model": "", "env": ["GEMINI_API_KEY", "GOOGLE_API_KEY", "GOOGLE_CLOUD_PROJECT"], "web": true,
      "read": ["agy", "--model", "{model}", "--sandbox", "--settings", "{\"toolPermission\":\"request-review\",\"allowNonWorkspaceAccess\":false,\"enableTerminalSandbox\":true,\"permissions\":{\"deny\":[\"write_file(*)\",\"command(*)\",\"mcp(*)\",\"read_url(*)\",\"execute_url(*)\",\"download_url(*)\"]}}", "--disable-slash-commands", "-p", "{prompt}"],
      "research": ["agy", "--model", "{model}", "--sandbox", "--settings", "{\"toolPermission\":\"request-review\",\"allowNonWorkspaceAccess\":false,\"enableTerminalSandbox\":true,\"permissions\":{\"allow\":[\"read_file(*)\",\"read_url(*)\"],\"deny\":[\"write_file(*)\",\"command(*)\",\"mcp(*)\",\"execute_url(*)\",\"download_url(*)\"]}}", "--disable-slash-commands", "-p", "{prompt}"],
      "build": ["agy", "--model", "{model}", "--sandbox", "--settings", "{\"toolPermission\":\"request-review\",\"allowNonWorkspaceAccess\":false,\"enableTerminalSandbox\":true,\"permissions\":{\"allow\":[\"read_file(*)\",\"write_file(*)\"],\"deny\":[\"command(*)\",\"mcp(*)\",\"read_url(*)\",\"execute_url(*)\",\"download_url(*)\"]}}", "--disable-slash-commands", "-p", "{prompt}"]
    },
    {
      "id": "mistral", "label": "Mistral", "model": "", "env": ["MISTRAL_API_KEY"], "max_price": 2, "clean_home": true,
      "read": ["vibe", "--prompt", "{prompt}", "--model", "{model}", "--enabled-tools", "read_file", "--max-price", "{price}", "--output", "text"],
      "build": ["vibe", "--prompt", "{prompt}", "--model", "{model}", "--enabled-tools", "read_file", "--enabled-tools", "write_file", "--enabled-tools", "search_replace", "--max-price", "{price}", "--output", "text"]
    }
  ]
}
